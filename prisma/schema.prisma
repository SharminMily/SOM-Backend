
generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider  = "postgresql"
  
}



enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}


enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}


enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}


enum LeaveType {
  ANNUAL
  SICK
  CASUAL
  UNPAID
}


enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}


enum PayrollStatus {
  DRAFT
  GENERATED
  PAID
}


enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}


enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}


enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}


enum MemberRole {
  LEAD
  MEMBER
  VIEWER
}


enum NotificationType {
  LEAVE_STATUS
  TASK_ASSIGNED
  ANNOUNCEMENT
  PAYSLIP_READY
  SYSTEM
}



model User {
  id             String     @id @default(uuid())
  email          String     @unique
  password   String
  firstName      String
  lastName       String
  phone          String?
  avatarUrl      String?
  role           Role       @default(EMPLOYEE)
  status         UserStatus @default(ACTIVE)
  emailVerified  Boolean    @default(false)
  joinedDate     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt


  departmentId   String?
  department     Department?   @relation("UserDept", fields: [departmentId], references: [id])
  managedDept    Department?   @relation("DeptHead")


  managerId      String?
  manager        User?         @relation("Reports", fields: [managerId], references: [id])
  reports        User[]        @relation("Reports")


  refreshTokens   RefreshToken[]
  attendances     Attendance[]
  leaveRequests   LeaveRequest[] @relation("Applicant")
  approvedLeaves  LeaveRequest[] @relation("Approver")
  leaveBalances   LeaveBalance[]
  payrolls        Payroll[]
  projectsCreated Project[]
  projectMembers  ProjectMember[]
  tasksAssigned   Task[]    @relation("AssignedTo")
  tasksCreated    Task[]    @relation("CreatedBy")
  taskComments    TaskComment[]
  announcements   Announcement[]
  notifications   Notification[]


  @@map("users")
}


model Department {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt


  headId      String?   @unique
  head        User?     @relation("DeptHead", fields: [headId], references: [id])
  users       User[]    @relation("UserDept")
  announcements Announcement[]


  @@map("departments")
}


model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())


  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@map("refresh_tokens")
}


model Attendance {
  id        String           @id @default(uuid())
  date      DateTime         @db.Date
  clockIn   DateTime?
  clockOut  DateTime?
  status    AttendanceStatus @default(ABSENT)
  note      String?
  createdAt DateTime         @default(now())


  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@unique([userId, date])
  @@map("attendances")
}


model LeaveRequest {
  id              String      @id @default(uuid())
  leaveType       LeaveType
  startDate       DateTime
  endDate         DateTime
  totalDays       Int
  reason          String
  status          LeaveStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt


  userId          String
  user            User   @relation("Applicant", fields: [userId], references: [id])
  approvedById    String?
  approvedBy      User?  @relation("Approver", fields: [approvedById], references: [id])


  @@map("leave_requests")
}


model LeaveBalance {
  id           String @id @default(uuid())
  year         Int
  annualTotal  Int    @default(20)
  annualUsed   Int    @default(0)
  sickTotal    Int    @default(10)
  sickUsed     Int    @default(0)
  casualTotal  Int    @default(5)
  casualUsed   Int    @default(0)


  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@unique([userId, year])
  @@map("leave_balances")
}


model Payroll {
  id          String        @id @default(uuid())
  month       Int
  year        Int
  baseSalary  Decimal       @db.Decimal(12, 2)
  allowances  Decimal       @default(0) @db.Decimal(12, 2)
  deductions  Decimal       @default(0) @db.Decimal(12, 2)
  netSalary   Decimal       @db.Decimal(12, 2)
  status      PayrollStatus @default(DRAFT)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())


  userId      String
  user        User   @relation(fields: [userId], references: [id])


  @@unique([userId, month, year])
  @@map("payrolls")
}


model Project {
  id          String        @id @default(uuid())
  title       String
  description String?
  status      ProjectStatus @default(PLANNING)
  progress    Int           @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt


  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  members     ProjectMember[]
  tasks       Task[]


  @@map("projects")
}


model ProjectMember {
  id        String     @id @default(uuid())
  role      MemberRole @default(MEMBER)
  joinedAt  DateTime   @default(now())


  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])


  @@unique([projectId, userId])
  @@map("project_members")
}


model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt


  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User     @relation("CreatedBy", fields: [createdById], references: [id])
  comments     TaskComment[]


  @@map("tasks")
}


model TaskComment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())


  taskId    String
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User   @relation(fields: [userId], references: [id])


  @@map("task_comments")
}


model Announcement {
  id            String   @id @default(uuid())
  title         String
  content       String
  isPinned      Boolean  @default(false)
  isCompanyWide Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt


  createdById  String
  createdBy    User        @relation(fields: [createdById], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])


  @@map("announcements")
}


model Notification {
  id        String           @id @default(uuid())
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  refId     String?
  createdAt DateTime         @default(now())


  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@map("notifications")
}
